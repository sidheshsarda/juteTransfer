def _get_next_invoice_no(conn, branch_id: int) -> int:
    """Get the next sequential invoice number for a branch in the current FY."""
    fy_start, fy_end = _get_financial_year_bounds()
    result = conn.execute(
        text("""SELECT COALESCE(MAX(invoice_no), 0) AS max_no
                FROM sales_invoice
                WHERE branch_id = :bid
                AND invoice_date BETWEEN :fy_start AND :fy_end"""),
        {
            "bid": branch_id,
            "fy_start": fy_start.strftime("%Y-%m-%d"),
            "fy_end": fy_end.strftime("%Y-%m-%d"),
        },
    )
    row = result.fetchone()
    return int(row[0] or 0) + 1


def _create_sales_invoice(conn, seller_step: TransferStep,
                           buyer_party_id: int, buyer_party_branch_id: Optional[int],
                           mr_id: int, source_mr: dict,
                           updated_by: int) -> int:
    """Create a sales invoice from the seller to the buyer.

    Inserts into sales_invoice, sales_invoice_dtl, and sales_invoice_jute.

    Returns the new invoice_id.
    """
    invoice_no = _get_next_invoice_no(conn, seller_step.branch_id)

    invoice_id = DatabaseConnection.execute_insert_returning_id(conn, """
        INSERT INTO sales_invoice (
            invoice_no, invoice_date, invoice_type, invoice_amount,
            party_id, billing_to_id, shipping_to_id, branch_id,
            active, status_id, round_off, updated_by, updated_date_time
        ) VALUES (
            :invoice_no, :invoice_date, :invoice_type, :invoice_amount,
            :party_id, :billing_to_id, :shipping_to_id, :branch_id,
            1, 0, 0, :updated_by, NOW()
        )
    """, {
        "invoice_no": invoice_no,
        "invoice_date": seller_step.mr_date,
        "invoice_type": RAW_JUTE_INVOICE_TYPE,
        "invoice_amount": seller_step.total_amount,
        "party_id": buyer_party_id,
        "billing_to_id": buyer_party_branch_id,
        "shipping_to_id": buyer_party_branch_id,
        "branch_id": seller_step.branch_id,
        "updated_by": updated_by,
    })

    # Line items from source MR
    for li in source_mr.get("line_items", []):
        accepted_weight = float(li.get("accepted_weight") or 0)
        amount = accepted_weight * seller_step.mr_rate / 100

        conn.execute(text("""
            INSERT INTO sales_invoice_dtl (
                invoice_id, item_id, hsn_code, quantity, sales_weight,
                rate, amount_without_tax, total_amount
            ) VALUES (
                :invoice_id, :item_id, :hsn_code, :quantity, :weight,
                :rate, :amount, :amount
            )
        """), {
            "invoice_id": invoice_id,
            "item_id": li.get("actual_item_id"),
            "hsn_code": None,
            "quantity": li.get("actual_qty"),
            "weight": accepted_weight,
            "rate": seller_step.mr_rate,
            "amount": amount,
        })

    # Jute-specific invoice data
    conn.execute(text("""
        INSERT INTO sales_invoice_jute (
            invoice_id, mr_no, mr_id, mukam_id, claim_amount,
            unit_conversion
        ) VALUES (
            :invoice_id, :mr_no, :mr_id, :mukam_id, :claim_amount,
            :unit_conversion
        )
    """), {
        "invoice_id": invoice_id,
        "mr_no": str(seller_step.mr_no),
        "mr_id": mr_id,
        "mukam_id": source_mr.get("mukam_id"),
        "claim_amount": int(seller_step.claim_amount or 0),
        "unit_conversion": source_mr.get("unit_conversion"),
    })

    return invoice_id


# ---------------------------------------------------------------------------
# Update original MR
# ---------------------------------------------------------------------------

def _update_original_mr(conn, jute_mr_id: int, final_rate: float,
                         final_party_id: int, final_party_branch_id: Optional[int],
                         final_total_amount: float, final_claim_amount: float,
                         final_net_amount: float, updated_by: int) -> None:
    """Update the original MR with final rate and party from last seller."""
    conn.execute(text("""
        UPDATE jute_mr SET
            party_id = :party_id,
            party_branch_id = :party_branch_id,
            total_amount = :total_amount,
            claim_amount = :claim_amount,
            net_total = :net_total,
            updated_by = :updated_by,
            updated_date_time = NOW()
        WHERE jute_mr_id = :mr_id
    """), {
        "party_id": str(final_party_id),
        "party_branch_id": final_party_branch_id,
        "total_amount": final_total_amount,
        "claim_amount": final_claim_amount,
        "net_total": final_net_amount,
        "updated_by": updated_by,
        "mr_id": jute_mr_id,
    })

    # Update line item rates
    conn.execute(text("""
        UPDATE jute_mr_li SET
            rate = :rate,
            total_price = accepted_weight * :rate / 100,
            updated_date_time = NOW()
        WHERE jute_mr_id = :mr_id
    """), {
        "rate": final_rate,
        "mr_id": jute_mr_id,
    })


# ---------------------------------------------------------------------------
# Main orchestrator
# ---------------------------------------------------------------------------

def finalize_transfer_chain(
    source_mr_id: int,
    steps: list[TransferStep],
    source_co_id: int,
    source_branch_id: int,
    updated_by: int,
) -> dict:
    """Execute the full transfer chain finalization in a single transaction.

    For a chain Source(A) -> B -> C -> ... -> A:
      - Step[0] = B (first receiver, gets MR from original supplier)
      - Steps[1..N-2] = intermediate companies (each receives MR, previous sells via invoice)
      - Step[-1] = A (final step, updates original MR)

    Args:
        source_mr_id: jute_mr_id of the original MR
        steps: List of TransferStep objects (including final step back to source)
        source_co_id: Original company's co_id
        source_branch_id: Original company's branch_id
        updated_by: User ID for audit fields

    Returns:
        dict with keys: mr_ids (list), invoice_ids (list)

    Raises:
        Exception on any failure (transaction auto-rolls-back)
    """
    if len(steps) < 2:
        raise ValueError("Transfer chain must have at least 2 steps (receiver + return to source)")

    mr_ids = []
    invoice_ids = []

    with DatabaseConnection.get_transaction() as conn:
        # Fetch source MR inside the transaction for consistency
        source_mr = get_source_mr_full(source_mr_id, conn=conn)
        if not source_mr:
            raise ValueError(f"Source MR {source_mr_id} not found")

        # Idempotency guard: check if already finalized
        existing = conn.execute(
            text("SELECT COUNT(*) FROM jute_mr WHERE src_jute_mr_id = :id"),
            {"id": source_mr_id},
        ).scalar()
        if existing:
            raise ValueError(
                f"MR {source_mr_id} has already been finalized "
                f"({existing} transferred MR(s) exist)"
            )
        # --- Step[0]: First receiver gets MR from original supplier ---
        first_step = steps[0]
        party_id, party_branch_id = _ensure_supplier_party(
            conn, source_mr, first_step.co_id, updated_by
        )
        first_mr_id = _create_mr(
            conn, source_mr, first_step, party_id, party_branch_id, updated_by
        )
        mr_ids.append(first_mr_id)

        prev_step = first_step
        prev_mr_id = first_mr_id

        # --- Steps[1..N-2]: Intermediate transfers ---
        for i in range(1, len(steps) - 1):
            current_step = steps[i]

            # Seller (prev) creates invoice to buyer (current)
            # 1. Ensure buyer exists as party in seller's company
            buyer_party_id, buyer_party_branch_id = _ensure_company_as_party(
                conn, current_step.co_id, current_step.branch_id,
                prev_step.co_id, updated_by
            )
            # 2. Create sales invoice
            inv_id = _create_sales_invoice(
                conn, prev_step, buyer_party_id, buyer_party_branch_id,
                prev_mr_id, source_mr, updated_by
            )
            invoice_ids.append(inv_id)

            # Buyer (current) receives MR with seller as party
            # 3. Ensure seller exists as party in buyer's company
            seller_party_id, seller_party_branch_id = _ensure_company_as_party(
                conn, prev_step.co_id, prev_step.branch_id,
                current_step.co_id, updated_by
            )
            # 4. Ensure supplier map in buyer
            _ensure_supplier_party_map(
                conn, int(source_mr.get("jute_supplier_id") or 0),
                current_step.co_id, seller_party_id, updated_by
            )
            # 5. Create MR for buyer
            new_mr_id = _create_mr(
                conn, source_mr, current_step,
                seller_party_id, seller_party_branch_id, updated_by
            )
            mr_ids.append(new_mr_id)

            prev_step = current_step
            prev_mr_id = new_mr_id

        # --- Step[-1]: Final step — last company sells back to source ---
        final_step = steps[-1]

        # Last intermediate company creates invoice to source
        source_party_id, source_party_branch_id = _ensure_company_as_party(
            conn, source_co_id, source_branch_id,
            prev_step.co_id, updated_by
        )
        final_inv_id = _create_sales_invoice(
            conn, prev_step, source_party_id, source_party_branch_id,
            prev_mr_id, source_mr, updated_by
        )
        invoice_ids.append(final_inv_id)

        # Ensure last seller exists as party in source company
        last_seller_party_id, last_seller_party_branch_id = _ensure_company_as_party(
            conn, prev_step.co_id, prev_step.branch_id,
            source_co_id, updated_by
        )

        # Update original MR with final rate and last seller as party
        _update_original_mr(
            conn, source_mr_id,
            final_rate=final_step.mr_rate,
            final_party_id=last_seller_party_id,
            final_party_branch_id=last_seller_party_branch_id,
            final_total_amount=final_step.total_amount,
            final_claim_amount=final_step.claim_amount,
            final_net_amount=final_step.net_amount,
            updated_by=updated_by,
        )

    logger.info(
        f"Transfer chain finalized for MR {source_mr_id}: "
        f"created {len(mr_ids)} MRs, {len(invoice_ids)} invoices"
    )
    return {"mr_ids": mr_ids, "invoice_ids": invoice_ids}
